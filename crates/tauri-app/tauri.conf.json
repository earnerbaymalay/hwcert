{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.earnerbaymalay.hwcert",
  "productName": "HWCert",
  "version": "0.1.0",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "HWCert - Hardware Diagnostic Suite",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "plugins": {},
  "bundle": {
    "icon": [
      "icons/icon.ico"
    ]
  }
}
